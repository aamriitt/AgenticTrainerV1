# --- Paths ---
KNOWLEDGE_DIR=./knowledge
CHROMA_DIR=./chroma_data
FEEDBACK_DB_PATH=./feedback.db

# --- LLM (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Alternative: nomic-ai/nomic-embed-text-v1.5

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- Retrieval ---
RETRIEVAL_TOP_K=5
HYBRID_ALPHA=0.5
# weight given to vector search vs BM25 (0=BM25 only, 1=vector only)

# --- Verification thresholds ---
MIN_CONTEXT_CHUNKS=2
MIN_RELEVANCE_SCORE=0.35

# --- Whisper ---
WHISPER_MODEL_SIZE=base

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- Atlas React frontend ---
# Use /api so the UI is not hardcoded to localhost. Vite (and preview)
# proxy /api → API_PROXY_TARGET. For a public API, set an absolute URL:
#   VITE_API_BASE_URL=https://your-api.example.com
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:8000
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=12

# --- RebootX tech refresh ---
USE_OLLAMA=true
REBOOTX_KNOWLEDGE_DIR=./knowledge/rebootx
# Copy RebootX JSON into knowledge/sop and index it for Ask Atlas on API start
ATLAS_SYNC_REBOOTX_KB=true

